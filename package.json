{
  "name": "@jupytergis/ui",
  "version": "0.16.2",
  "description": "JupyterLab-themed shadcn/Base UI components for Jupyter extensions.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "shadcn",
    "react",
    "tailwind"
  ],
  "homepage": "https://github.com/gjmooney/jupytergis-ui",
  "bugs": {
    "url": "https://github.com/gjmooney/jupytergis-ui/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "JupyterGIS contributors"
  },
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "style/**/*.{css,js}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./style": "./style/index.css",
    "./style/*": "./style/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gjmooney/jupytergis-ui.git"
  },
  "scripts": {
    "build": "pnpm run build:tailwind && tsc -b",
    "build:tailwind": "tailwindcss -i ./style/tailwind.in.css -o ./style/tailwind.css",
    "build:prod": "pnpm run clean && pnpm run build",
    "build:dev": "pnpm run build",
    "clean": "rimraf tsconfig.tsbuildinfo",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:all": "pnpm run clean:lib",
    "watch": "tsc -w"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.513.0",
    "react-day-picker": "^9.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/webpack-env": "^1.18.5",
    "react": "^18.0.1",
    "react-dom": "18.3.1",
    "rimraf": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "sideEffects": [
    "style/*.css"
  ],
  "styleModule": "style/index.js",
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "access": "public"
  }
}
